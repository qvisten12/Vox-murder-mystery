  "captions": [
    {
      "start": 0.0,
      "end": 2.54,
      "text": "February 28th, 1986."
    },
    {
      "start": 2.87,
      "end": 3.68,
      "text": "Stockholm."
    },
    {
      "start": 3.96,
      "end": 5.69,
      "text": "A man walks home from the cinema"
    },
    {
      "start": 5.74,
      "end": 6.51,
      "text": "with his wife."
    },
    {
      "start": 6.9,
      "end": 7.78,
      "text": "No bodyguards."
    },
    {
      "start": 7.84,
      "end": 8.57,
      "text": "No car."
    },
    {
      "start": 8.89,
      "end": 10.75,
      "text": "He is the Prime Minister of Sweden."
    },
    {
      "start": 10.99,
      "end": 12.46,
      "text": "That morning, Olof Palme"
    },
    {
      "start": 12.5,
      "end": 14.21,
      "text": "sent his security detail home."
    },
    {
      "start": 14.59,
      "end": 16.22,
      "text": "He wanted one normal Friday night."
    },
    {
      "start": 16.54,
      "end": 18.11,
      "text": "At 11:21 p.m.,"
    },
    {
      "start": 18.23,
      "end": 19.31,
      "text": "on Sveavägen,"
    },
    {
      "start": 19.55,
      "end": 21.47,
      "text": "a man steps out of the dark behind him."
    },
    {
      "start": 21.79,
      "end": 22.59,
      "text": "One shot."
    },
    {
      "start": 22.87,
      "end": 23.66,
      "text": "In the back."
    },
    {
      "start": 23.91,
      "end": 25.2,
      "text": "At point-blank range."
    }
  ],
