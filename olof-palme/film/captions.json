[
  {
    "start": 0,
    "end": 2.543,
    "text": "February 28th, 1986."
  },
  {
    "start": 2.868,
    "end": 3.68,
    "text": "Stockholm."
  },
  {
    "start": 3.959,
    "end": 5.863,
    "text": "A man walks home from the cinema with"
  },
  {
    "start": 5.898,
    "end": 6.513,
    "text": "his wife."
  },
  {
    "start": 6.896,
    "end": 7.779,
    "text": "No bodyguards."
  },
  {
    "start": 7.837,
    "end": 8.568,
    "text": "No car."
  },
  {
    "start": 8.893,
    "end": 10.751,
    "text": "He is the Prime Minister of Sweden."
  },
  {
    "start": 10.995,
    "end": 13.758,
    "text": "That morning, Olof Palme sent his security detail"
  },
  {
    "start": 13.816,
    "end": 14.211,
    "text": "home."
  },
  {
    "start": 14.594,
    "end": 16.219,
    "text": "He wanted one normal Friday night."
  },
  {
    "start": 16.544,
    "end": 19.876,
    "text": "At 11:21 p.m., on Sveavägen, a man"
  },
  {
    "start": 19.934,
    "end": 21.467,
    "text": "steps out of the dark behind him."
  },
  {
    "start": 21.792,
    "end": 22.593,
    "text": "One shot."
  },
  {
    "start": 22.872,
    "end": 23.661,
    "text": "In the back."
  },
  {
    "start": 23.905,
    "end": 25.205,
    "text": "At point-blank range."
  },
  {
    "start": 25.588,
    "end": 27.701,
    "text": "A second bullet grazes his wife, Lisbet."
  },
  {
    "start": 28.085,
    "end": 30.209,
    "text": "The gunman runs up the stairs of Tunnelgatan,"
  },
  {
    "start": 30.36,
    "end": 31.44,
    "text": "and disappears."
  },
  {
    "start": 31.765,
    "end": 33.471,
    "text": "The police don't seal off the city."
  },
  {
    "start": 33.796,
    "end": 36.002,
    "text": "The national alarm comes hours too late."
  },
  {
    "start": 36.327,
    "end": 37.906,
    "text": "The revolver is never found."
  },
  {
    "start": 38.231,
    "end": 40.577,
    "text": "In 1988, Lisbet picks a man out of"
  },
  {
    "start": 40.612,
    "end": 42.585,
    "text": "a lineup: Christer Pettersson."
  },
  {
    "start": 42.91,
    "end": 45.081,
    "text": "He's convicted, then freed on appeal."
  },
  {
    "start": 45.406,
    "end": 46.022,
    "text": "No weapon."
  },
  {
    "start": 46.138,
    "end": 46.8,
    "text": "No motive."
  },
  {
    "start": 47.183,
    "end": 48.808,
    "text": "Over a hundred people confess."
  },
  {
    "start": 49.249,
    "end": 50.109,
    "text": "None of them did it."
  },
  {
    "start": 50.434,
    "end": 53.882,
    "text": "Then, in 2020, after thirty-four years, prosecutors"
  },
  {
    "start": 53.94,
    "end": 56.958,
    "text": "name a new suspect: Stig Engström, the"
  },
  {
    "start": 56.993,
    "end": 59.629,
    "text": "\"Skandia Man,\" an office worker who said he"
  },
  {
    "start": 59.687,
    "end": 60.917,
    "text": "was a witness at the scene."
  },
  {
    "start": 61.359,
    "end": 63.646,
    "text": "But Engström had died twenty years earlier."
  },
  {
    "start": 63.971,
    "end": 65.039,
    "text": "He was never charged."
  },
  {
    "start": 65.422,
    "end": 66.49,
    "text": "The case was closed."
  },
  {
    "start": 66.874,
    "end": 68.116,
    "text": "The gun is still missing."
  },
  {
    "start": 68.29,
    "end": 69.672,
    "text": "No one was ever convicted."
  },
  {
    "start": 70.275,
    "end": 72.156,
    "text": "So, was it the Skandia Man..."
  },
  {
    "start": 72.481,
    "end": 74.792,
    "text": "or someone who walked away that night, and"
  },
  {
    "start": 74.85,
    "end": 75.929,
    "text": "was never found?"
  }
]
